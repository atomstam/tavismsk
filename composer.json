{
    "name": "cyp/tavis",
    "description": "TAVIS – Traffic Vaccine Intelligent System (ระบบวัคซีนจราจร) สำนักงานเขตพื้นที่การศึกษามัธยมศึกษามหาสารคาม",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.1",
        "firebase/php-jwt": "^6.10",
        "google/apiclient": "^2.15",
        "mpdf/mpdf": "^8.2",
        "phpmailer/phpmailer": "^6.9",
        "phpoffice/phpspreadsheet": "^1.29",
        "vlucas/phpdotenv": "^5.6"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        },
        "files": [
            "app/Helpers/helpers.php",
            "app/Helpers/datatable.php"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "platform-check": false,
        "audit": {
            "block-insecure": false
        }
    },
    "scripts": {}
}
