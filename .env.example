APP_NAME="TAVIS – ระบบวัคซีนจราจร"
APP_SHORT_NAME="TAVIS"
APP_ENV=local
APP_DEBUG=true
# Local (XAMPP): http://localhost/traffic_vaccine/public
# Production: https://tavis.thaiedu.in.th
APP_URL=http://localhost/traffic_vaccine
APP_KEY=change-this-to-random-32-char-string
APP_TIMEZONE=Asia/Bangkok
APP_LOCALE=th

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=tavis
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4

SESSION_LIFETIME=120
SESSION_TIMEOUT=3600

MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=tavis@cyp.ac.th
MAIL_FROM_NAME="TAVIS CYP"

JWT_SECRET=change-this-jwt-secret-key-min-32
JWT_EXPIRE=86400

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Social Login (Facebook / Google / LINE) — ว่าง Client ID = ปิดปุ่ม
# OAUTH_CANONICAL_BASE_URL=https://tavis.thaiedu.in.th
OAUTH_CANONICAL_BASE_URL=
OAUTH_FACEBOOK_CLIENT_ID=
OAUTH_FACEBOOK_CLIENT_SECRET=
OAUTH_FACEBOOK_REDIRECT_URI=http://localhost/traffic_vaccine/auth/facebook/cb
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_GOOGLE_REDIRECT_URI=http://localhost/traffic_vaccine/auth/google/cb
OAUTH_LINE_CHANNEL_ID=
OAUTH_LINE_CHANNEL_SECRET=
OAUTH_LINE_REDIRECT_URI=http://localhost/traffic_vaccine/auth/line/cb

# Google Drive — ปิดโดยค่าเริ่มต้น
# วาง service account ที่ storage/credentials/google-drive.json (ไฟล์นี้ไม่ถูก commit)
GOOGLE_DRIVE_ENABLED=false
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_DRIVE_CREDENTIALS=storage/credentials/google-drive.json
GOOGLE_DRIVE_IMPERSONATE_USER=
GOOGLE_DRIVE_SYSTEM_FOLDER=_system
GOOGLE_DRIVE_IMAGES_FOLDER=images
GOOGLE_DRIVE_FILES_FOLDER=files
GOOGLE_DRIVE_MEDIA_CACHE_BUST=1

# AI ผู้ช่วย (OpenAI) — ใส่คีย์แล้วใช้งานที่ /admin/ai ได้ทันที
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TIMEOUT=45
OPENAI_MAX_TOKENS=1200

RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
